# ===== DB =====
# Schema chính (Spring đọc/ghi). Tài khoản này CHỈ có quyền SELECT.
CORE_DB_URL=mysql+pymysql://ai_svc:AI_SERVICE_PASSWORD@localhost:3306/rental_db
# Schema riêng của AI service (Alembic quản lý).
AI_DB_URL=mysql+pymysql://ai_svc:AI_SERVICE_PASSWORD@localhost:3306/rental_ai

# ===== JWT (phải khớp với app.jwt.* của Spring) =====
# Spring ký bằng HS512 với secret trong JWT_SECRET (>= 64 byte).
JWT_ALG=HS512
JWT_SECRET=
JWT_ISSUER=rental-management
AUTH_VERSION_CACHE_SECONDS=30

# ===== LLM local (Ollama, OpenAI-compatible) =====
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
LOCAL_LLM_API_KEY=ollama
LOCAL_TIMEOUT_SECONDS=90
CHAT_NEARBY_RADIUS_KM=3
CHAT_PRICE_TOLERANCE_PCT=20

# ===== LLM ngoài (fallback) =====
ALLOW_EXTERNAL_FALLBACK=false
# anthropic | gemini
EXTERNAL_PROVIDER=gemini
# Gemini: đổi theo model mà API key của bạn được phép dùng.
EXTERNAL_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
EXTERNAL_DAILY_CAP=2000

# ===== Embedding =====
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# ===== Giới hạn =====
CHAT_DAILY_LIMIT_PER_USER=30
MAX_CONCURRENT_PER_USER=3
CHAT_TIMEOUT_SECONDS=240
QUOTA_TIMEZONE=Asia/Ho_Chi_Minh
EMBEDDING_RELOAD_SECONDS=60
CORS_ORIGINS=["http://localhost:4200","http://localhost"]
