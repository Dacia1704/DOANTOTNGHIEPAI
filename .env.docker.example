# Optional: build AI Dockerfile manually; Compose only starts Ollama.
# Copy to .env.docker and fill secrets. BE/MySQL and Ollama publish host ports.
# docker build -t rental-ai-service .
# docker run --rm --env-file .env.docker -p 8000:8000 rental-ai-service
CORE_DB_URL=mysql+pymysql://ai_svc:URL_ENCODED_PASSWORD@host.docker.internal:3306/rental_db
AI_DB_URL=mysql+pymysql://ai_svc:URL_ENCODED_PASSWORD@host.docker.internal:3306/rental_ai
JWT_ALG=HS512
JWT_SECRET=
JWT_ISSUER=rental-management
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
LOCAL_TIMEOUT_SECONDS=90
LOCAL_LLM_API_KEY=ollama
ALLOW_EXTERNAL_FALLBACK=false
EXTERNAL_PROVIDER=gemini
EXTERNAL_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
EXTERNAL_DAILY_CAP=2000
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
EMBEDDING_RELOAD_SECONDS=60
CHAT_DAILY_LIMIT_PER_USER=30
MAX_CONCURRENT_PER_USER=3
CHAT_TIMEOUT_SECONDS=240
QUOTA_TIMEZONE=Asia/Ho_Chi_Minh
CORS_ORIGINS=["http://localhost:4200","http://localhost"]
